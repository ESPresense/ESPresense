# -coexist variants (ESPA-196 FW-1): CSI+BLE coexistence measurement.
# CSI needs the RX callback API compiled in; console UART baud is bumped from
# 115200 to 921600 (matched by the HIL --baud flag for these envs) because a
# 100 Hz sweep point streams base64 §B CSI frames fast enough to exceed
# 115200's ~11.5 KB/s ceiling - the console is the only channel this test
# firmware has back to the harness, there is no MQTT broker guaranteed on the
# bench host.
# Renamed between IDF releases (older snapshots use CONFIG_ESP32_WIFI_CSI_ENABLED);
# confirmed CONFIG_ESP_WIFI_CSI_ENABLED is the real v5.4.4 name against the actual
# esp_wifi.h source, not the possibly-stale Arduino-bundled copy this was first
# checked against. An unknown key here would have silently no-op'd (not failed the
# build) and left CSI capture permanently off - worth getting right the first time.
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
